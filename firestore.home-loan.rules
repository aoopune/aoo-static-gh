rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Home loan applications (project: home-loan-apps).
    // Submit once: a saved application cannot be changed or deleted by the customer.
    // Apply again = create a new application document only.
    match /applications/{appId} {
      allow read: if request.auth != null
        && request.auth.token.email == resource.data.email;
      allow create: if request.auth != null
        && request.auth.token.email == request.resource.data.email;
      allow update, delete: if false;
    }
    match /_counters/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
