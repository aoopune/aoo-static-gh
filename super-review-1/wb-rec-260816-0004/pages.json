    "forms": [
      {
        "name": "Loan inputs",
        "fields": [
          {
            "label": "Monthly income*\n                        \n                      \n                      Sets how much loan banks can offer you. Use take-home, not CTC.\n                      Learn more\n                 ",
            "type": "text",
            "required": true
          },
          {
            "label": "Property agreement value*\n                        \n                      \n                      Sets the ceiling on the loan against this house. Use the sale agreement price.\n                      Lea",
            "type": "text",
            "required": true
          },
          {
            "label": "Age*\n                          \n                        \n                        Sets the longest tenure banks will allow.\n                        Learn more\n                      \n                   ",
            "type": "text",
            "required": true
          },
          {
            "label": "CIBIL score*\n                          \n                        \n                        Changes the rates banks show you.",
            "type": "text",
            "required": true
          },
          {
            "label": "Existing EMIs\n                          \n                        \n                        Lowers how much new loan you can get.\n                        Learn more\n                      \n              ",
            "type": "text",
            "required": false
          },
          {
            "label": "Share of income for EMIs /FOIR\n                          \n                        \n                        Cap on EMIs versus income. Leave at 55% unless you know another figure.\n                     ",
            "type": "select",
            "required": false
          },
          {
            "label": "Tenure*\n                          \n                        \n                        Years to repay. Changes your EMI.\n                        Learn more\n                      \n                    \n   ",
            "type": "text",
            "required": true
          },
          {
            "label": "Co-applicant income\n                                \n                              \n                              Added to yours for eligibility.\n                              Learn more\n             ",
            "type": "text",
            "required": false
          },
          {
            "label": "Co-applicant EMIs\n                                \n                              \n                              Lowers eligibility the same way yours do.\n                              Learn more\n     ",
            "type": "text",
            "required": false
          }
        ]
      }
