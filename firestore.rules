rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Loan applications: signed-in users can create and read their own
    match /applications/{appId} {
      allow read, write: if request.auth != null;
    }
    // Counter for unique 6-digit application IDs (transaction read/write)
    match /_counters/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
